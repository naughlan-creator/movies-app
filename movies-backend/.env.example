# Copy these ENV vars to .env and fill in real values. Never commit .env.
MONGO_DATABASE=
# Either the three Atlas values below...
MONGO_USER=
MONGO_PASSWORD=
MONGO_CLUSTER=
# ...or a full connection string, which takes precedence. For the local replica set from docker compose:
# (Leave it commented out to use Atlas: an empty value would override the Atlas URI with "".)
# MONGO_URI=mongodb://localhost:27017/movies?directConnection=true
# Optional. Remove this line to use the default (8080).
SERVER_PORT=
# Optional as well. Comma-separated. Defaults to http://localhost:3000
CORS_ALLOWED_ORIGINS=
# TMDB "API Read Access Token" (themoviedb.org > Settings > API). Without it the trending sync is skipped.
TMDB_API_TOKEN=
# Optional. Set to false in production to hide /swagger-ui.html and /v3/api-docs
API_DOCS_ENABLED=
# Optional: load the secrets above from Vault instead (see vault/seed-dev-secrets.ps1, which fills in
# VAULT_ROLE_ID and VAULT_SECRET_ID). Values from Vault override this file.
# VAULT_ENABLED=true
# VAULT_URI=http://localhost:18200
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# Optional. Keycloak realm URLs; default to the docker compose Keycloak on localhost:18180.
# Uncomment only to change them (an empty value would override the default with "").
# OIDC_ISSUER_URI=http://localhost:18180/realms/movie-gold
# OIDC_JWK_SET_URI=http://localhost:18180/realms/movie-gold/protocol/openid-connect/certs
# <put_your_sk-ant-...key...> for AI inference implementation
ANTHROPIC_API_KEY=
AI_DIGEST_REFRESH_ENABLED=
AI_DIGEST_DELAY= # put seconds : 30s recommended