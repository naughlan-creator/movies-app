# Serves the built React app inside the frontend container
:80 {
	root * /srv
	encode zstd gzip

	# Single-page app: a deep link like /Reviews/tt3915174 has no file on disk, so serve index.html
	# and let React Router show the right page
	try_files {path} /index.html
	file_server

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Build files have content hashes in their names (main.3f9a1c.js), so they never change:
	# browsers may cache them for a year. index.html is not hashed, so it's always revalidated.
	@hashed path /static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@entry path / /index.html
	header @entry Cache-Control "no-cache"
}
