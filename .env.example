# Docker Compose reads ./.env. Copy this file to .env and fill in the values.
# Generate strong values, e.g. in PowerShell:
#   $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)

# Keycloak's own administrator (admin console at http://localhost:18180). Not an app user.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Password for the dev users movie_fan_42 / movie_fan_43 created by keycloak/create-dev-users.ps1
KEYCLOAK_DEV_USER_PASSWORD=

# Root token for the dev-mode Vault server (step 2.8)
VAULT_DEV_ROOT_TOKEN=
